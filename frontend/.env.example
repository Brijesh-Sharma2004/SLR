# Backend origin used by Next.js rewrites and server-side data fetching.
# In production (for example on Vercel), set this to the public backend origin.
# When it is omitted, the app falls back to the origin in NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3001

# Backend API URL used by browser requests.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
